    FCcutoff = log2(1.5),
    pointSize = 1,#
    labSize = 2.0,#3
    colAlpha = 1,
    legendPosition = "bottom",
    legendLabSize = 5,
    legendIconSize = 3,
    border = "full",
    borderWidth = 1,
    borderColour = "black",
    gridlines.major = FALSE,
    gridlines.minor = FALSE,
    )
garbage <- dev.off()

